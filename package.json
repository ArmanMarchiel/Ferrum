{
  "name": "cad-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Part STL in, investment shell mould + gating tree out",
  "scripts": {
    "dev": "cd backend/src && ../../.venv/bin/python -m uvicorn server.app:app --reload --port 8000",
    "dev:web": "cd frontend && npm run dev",
    "build:web": "cd frontend && npm run build",
    "typecheck": "cd frontend && npm run typecheck",
    "cli": "cd backend && ../.venv/bin/python cad2shell.py",
    "test": "cd backend && ../.venv/bin/python -m pytest -q",
    "install:py": ".venv/bin/pip install -r requirements.txt",
    "install:web": "cd frontend && npm install",
    "kill": "lsof -ti:8000 | xargs kill -9 || true; lsof -ti:5173 | xargs kill -9 || true"
  }
}
